# Telegram MTProto credentials
# Get TG_API_ID and TG_API_HASH from: https://my.telegram.org → API development tools

TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Session string — generated once by running: bun run auth.ts
# Keep this secret! It grants full access to your Telegram account.
TG_SESSION=

# ─────────────────────────────────────────────────────────────
# Rate Limits Reference
# ─────────────────────────────────────────────────────────────
#
# search-hashtag   → Unlimited (free, no daily quota)
# search-query     → ~10-30 free searches/day; after exhaustion requires Stars
# search-channel   → No daily limit (flood wait only)
# search-global    → No daily limit (flood wait only)
#
# Ways to increase search-query limit:
# 1. Use search-hashtag instead (hashtag searches are always free)
# 2. Pay with Telegram Stars (passed via allow_paid_stars parameter)
# 3. Use a Telegram Premium account (higher daily quota)
# 4. Use multiple authenticated accounts with separate session strings
#    (TG_SESSION_2, TG_SESSION_3, etc.) — rotate between them
